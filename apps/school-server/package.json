{
  "name": "@cbt/school-server",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS school server: Exam API, Console API, WebSocket, sync agent and backups (runs on the school lab PC).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "clean": "node ../../scripts/clean.mjs dist"
  },
  "dependencies": {
    "@cbt/shared-types": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "helmet": "8.3.0",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@swc/core": "1.16.18",
    "@types/node": "26.6.5",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.4"
  }
}
