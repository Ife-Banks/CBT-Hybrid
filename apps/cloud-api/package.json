{
  "name": "@cbt/cloud-api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS cloud API: REST, Sync API and background workers.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "clean": "node ../../scripts/clean.mjs dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@casl/ability": "7.0.2",
    "@cbt/exam-core": "workspace:*",
    "@cbt/shared-types": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "^12.0.4",
    "argon2": "0.45.1",
    "drizzle-orm": "^0.45.4",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "otplib": "13.5.0",
    "pino": "10.4.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@swc/core": "1.16.18",
    "@types/node": "26.6.5",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.4"
  }
}
