{
  "name": "@cbt/exam-core",
  "version": "0.0.0",
  "private": true,
  "description": "Pure TypeScript algorithms: student codes, exam keys, shuffle, marking, packs and crypto helpers.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "node ../../scripts/clean.mjs dist"
  },
  "dependencies": {
    "libphonenumber-js": "1.13.15"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
