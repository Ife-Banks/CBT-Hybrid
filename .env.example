# =============================================================================
# CBT Platform - development environment
# Copy to `.env` and fill in. Never commit `.env`.
#
# Development uses managed cloud services (no local Docker required):
#   Postgres  -> Neon          https://neon.tech
#   Redis     -> Upstash       https://upstash.com
#   Object S3 -> Cloudflare R2 https://developers.cloudflare.com/r2
# =============================================================================

NODE_ENV=development

# --- Cloud API ---
# Canonical names (CBT-04 section 11.1). PORT/PUBLIC_URL are what a cloud host
# injects. CLOUD_API_PORT/CLOUD_API_PUBLIC_URL are optional local overrides that
# let the cloud API and school server run from this single .env file.
PORT=3000
PUBLIC_URL=http://localhost:3000
CLOUD_API_PORT=3000
CLOUD_API_PUBLIC_URL=

# --- Authentication (Phase 2) ---
# Signs the CSRF token. Required in production; a development placeholder is
# used when unset outside production. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Session lifetimes in seconds: staff 12h, parents 30 days (sliding).
SESSION_TTL_STAFF_SECONDS=43200
SESSION_TTL_PARENT_SECONDS=2592000
# Account lockout: 5 failed sign-ins, then locked for 15 minutes.
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_SECONDS=900
# Password-reset codes: 6 digits, valid 10 minutes, 5 attempts, resend after 60s.
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
# Sign-in rate limit: 10 attempts per minute per IP.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=60000
# Development only: JSON array of accounts to seed at startup (ignored in
# production; Phase 2 keeps users in memory). Example:
# AUTH_DEV_SEED=[{"email":"admin@school.ng","password":"TestPassword123!","role":"school_admin","fullName":"Ada Okafor","schoolCode":"GRA","schoolName":"Graceland College"}]
AUTH_DEV_SEED=

# --- School server ---
# Canonical port is PORT; set SCHOOL_SERVER_PORT so the school server does not
# also bind the cloud API's port when both run locally.
SCHOOL_SERVER_PORT=8080
CBT_DATA_DIR=./data

# --- PostgreSQL (Neon) ---
# Keep sslmode=require for Neon.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/cbt_cloud?sslmode=require

# --- Redis (Upstash) ---
# Use the TLS (rediss://) URL.
REDIS_URL=rediss://default:PASSWORD@xxxx.upstash.io:6379

# --- Object storage (Cloudflare R2, S3-compatible) ---
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=cbt-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Public URL prefix for stored assets (optional).
S3_PUBLIC_BASE_URL=

# --- Mail (development) ---
# In development, notification emails are logged to the console unless a
# real SMTP endpoint is provided.
SMTP_URL=
MAIL_FROM=no-reply@cbt.local
